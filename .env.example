# Supabase — salin file ini menjadi .env.local lalu isi nilainya
# (dapatkan dari Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# HANYA untuk server (Vercel environment variable), JANGAN di .env.local:
# Service role key untuk API Admin (kelola pengguna) — diambil dari
# Project Settings → API → service_role. Simpan di Vercel: vercel env add SUPABASE_SERVICE_ROLE_KEY production
# SUPABASE_SERVICE_ROLE_KEY=
